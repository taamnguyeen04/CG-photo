### Test 2: Unit Test Uncertainty Formula

```bash
cat > /media/tam/DATA/3D/CG-photo/scripts/test_uncertainty_formula.py << 'EOF'
import torch
import math

def test_obs_confidence():
    tau_obs = 10.0
    obs_count = torch.tensor([0, 5, 10, 20, 50, 100])
    expected = 1 - torch.exp(-obs_count.float() / tau_obs)
    # count=0 → conf=0, count=10 → conf≈0.632, count=100 → conf≈1.0
    print("obs_count:", obs_count.tolist())
    print("obs_confidence:", expected.tolist())
    assert expected[0] == 0.0
    assert abs(expected[2] - 0.632) < 0.01
    print("✓ obs_confidence test passed")

def test_combined_uncertainty():
    obs_conf = torch.tensor([0.0, 0.5, 1.0])
    res_conf = torch.tensor([0.0, 0.5, 1.0])
    depth_conf = torch.tensor([0.0, 0.5, 1.0])
    w1, w2, w3 = 0.4, 0.4, 0.2
    
    sigma = 1.0 - (w1 * obs_conf + w2 * res_conf + w3 * depth_conf)
    print("combined_uncertainty:", sigma.tolist())
    # When all conf=0 → σ=1 (uncertain), all conf=1 → σ=0 (certain)
    assert sigma[0] == 1.0
    assert sigma[2] == 0.0
    print("✓ combined_uncertainty test passed")

if __name__ == "__main__":
    test_obs_confidence()
    test_combined_uncertainty()
    print("\n✓ All tests passed!")
EOF

python /media/tam/DATA/3D/CG-photo/scripts/test_uncertainty_formula.py
```

